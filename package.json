{
  "name": "expense-tracker-bot",
  "version": "1.0.0",
  "private": true,
  "description": "Multi-user private Telegram expense tracker + admin bot (serverless on Vercel + Neon PostgreSQL)",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx src/dev.ts",
    "build": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "webhook:set": "node scripts/set-webhook.mjs"
  },
  "dependencies": {
    "@neondatabase/serverless": "^0.10.0",
    "dotenv": "^16.4.5",
    "grammy": "^1.30.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
