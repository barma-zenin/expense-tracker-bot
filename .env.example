# ── Telegram ─────────────────────────────────────────────────────────────
# Token of the user (expense tracker) bot — from @BotFather
TELEGRAM_BOT_TOKEN=123456789:AA...
# Token of the admin bot — from @BotFather (create a second bot)
TELEGRAM_ADMIN_BOT_TOKEN=123456789:BB...
# Your numeric Telegram ID(s), comma-separated if more than one — from @userinfobot
ADMIN_IDS=123456789

# ── Database ─────────────────────────────────────────────────────────────
# Neon "serverless" connection string (see README) — or any Neon HTTP URL.
# NOTE: the current code uses the Neon HTTP driver, so a plain localhost
# Postgres will NOT work without code changes.
DATABASE_URL=postgresql://user:password@ep-xxx.region.aws.neon.tech/neondb?sslmode=require

# ── Optional ─────────────────────────────────────────────────────────────
CURRENCY=LKR
DEFAULT_TIMEZONE=Asia/Colombo
# true = new users skip the admin approval step
AUTO_APPROVE=false
# Any long random string — protects the /api/cron endpoint
CRON_SECRET=change-me
