# ── Telegram ──────────────────────────────────────────────
# Token of the user bot (from @BotFather) — the expense tracker
TELEGRAM_BOT_TOKEN=

# Token of the admin bot (from @BotFather) — only admins can use it
TELEGRAM_ADMIN_BOT_TOKEN=

# Comma-separated Telegram numeric IDs of admins (get yours from @userinfobot)
ADMIN_IDS=123456789

# ── Database (Neon serverless Postgres) ───────────────────
# Use the "connection string for serverless driver" from Neon console
DATABASE_URL=postgresql://user:password@ep-xxx.region.aws.neon.tech/dbname?sslmode=require

# ── Bot behaviour ─────────────────────────────────────────
# Currency symbol/code shown in messages (default LKR)
CURRENCY=LKR

# Default IANA timezone for new users (default Asia/Colombo)
DEFAULT_TIMEZONE=Asia/Colombo

# If true, new users can use the bot immediately without admin approval.
# If false (default), new users are "pending" until an admin approves them.
AUTO_APPROVE=false

# Secret used to protect the /api/cron scheduler endpoint.
# MUST match the value you configure on cron-job.org.
CRON_SECRET=change-me-to-a-long-random-string
